{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,backend/tests/**,backend/.venv/**,docs/**,scripts/**,data/**,out/**,**/__pycache__/**}"
    }
  }
}
